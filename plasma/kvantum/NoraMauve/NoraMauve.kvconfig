[%General]
author=Tux Wraith
comment=Nora Mauve - dark Kvantum theme matching the Nora GTK Mauve palette (#3b4252 base, #c6a0f6 mauve accent)

[PushButton]
frame=false
interior.element=button
text.normal.color=#d8dee9
text.focus.color=#d8dee9
text.press.color=#d8dee9
text.toggle.color=#24273a
text.disabled.color=#8a909e
text.margin.top=4
text.margin.bottom=4
text.margin.left=10
text.margin.right=10

[PanelButtonCommand]
inherits=PushButton

[PanelButtonTool]
inherits=PanelButtonCommand

[ToolButton]
inherits=PushButton

[Tab]
frame=false
interior.element=tab
text.normal.color=#d8dee9
text.focus.color=#d8dee9
text.press.color=#24273a
text.toggle.color=#24273a
text.disabled.color=#8a909e

[LineEdit]
frame=false
interior.element=lineedit
text.normal.color=#d8dee9
text.focus.color=#d8dee9
text.disabled.color=#8a909e
text.margin.left=6
text.margin.right=6

[ComboBox]
inherits=LineEdit

[SpinBox]
inherits=LineEdit

[MenuItem]
frame=false
interior.element=menuitem
text.normal.color=#d8dee9
text.focus.color=#24273a
text.press.color=#24273a
text.disabled.color=#8a909e
text.margin.top=4
text.margin.bottom=4
text.margin.left=8
text.margin.right=8

[Tooltip]
frame=false
interior.element=tooltip
text.normal.color=#d8dee9
text.margin.top=4
text.margin.bottom=4
text.margin.left=6
text.margin.right=6
